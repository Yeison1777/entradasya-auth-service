SERVICE_NAME=auth-service
PORT=3001
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://auth_user:change-me@localhost:5432/auth_db
JWT_SECRET=replace-with-a-long-local-secret
JWT_EXPIRES_IN_SECONDS=3600
INTERNAL_API_KEY=replace-with-the-same-internal-key-used-by-services
SEED_ORGANIZER_EMAIL=organizador@entradasya.local
SEED_ORGANIZER_PASSWORD=replace-with-a-secure-local-password
SEED_DOOR_STAFF_EMAIL=portero@entradasya.local
SEED_DOOR_STAFF_PASSWORD=replace-with-a-secure-local-password
SEED_CLIENT_EMAIL=cliente@entradasya.local
SEED_CLIENT_PASSWORD=replace-with-a-secure-local-password
